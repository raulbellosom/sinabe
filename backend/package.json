{
  "name": "sinabe-backend",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "nodemon -L src/index.js",
    "start": "node src/index.js",
    "prisma": "npx prisma",
    "db:generate": "npx prisma generate",
    "db:pull": "npx prisma db pull",
    "db:status": "npx prisma migrate status",
    "db:migrate:dev": "npx prisma migrate dev",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:seed": "node prisma/seeders/seed.js",
    "generate": "npm run db:generate",
    "pull": "npm run db:pull",
    "migrate": "npm run db:migrate:dev",
    "seed": "npm run db:seed",
    "prepare:prod": "npm run db:generate && npm run db:migrate:deploy",
    "preprod": "npm run prepare:prod",
    "prod": "npm run prepare:prod && pm2 startOrRestart ecosystem.config.cjs --only sinabe-backend --update-env",
    "prod:dev": "npm run prepare:prod && pm2 startOrRestart ecosystem.config.cjs --only sinabe-backend-dev --update-env",
    "logs": "pm2 logs sinabe-backend",
    "logs:dev": "pm2 logs sinabe-backend-dev"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "axios": "^1.7.4",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "cron-parser": "^5.4.0",
    "csv-parser": "^3.0.0",
    "date-fns": "^3.6.0",
    "docx": "^9.5.1",
    "docxtemplater": "^3.67.6",
    "docxtemplater-image-module-free": "^1.1.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.12",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pizzip": "^3.2.0",
    "puppeteer": "^24.31.0",
    "sharp": "^0.33.4",
    "uuid": "^10.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^6.1.0"
  },
  "keywords": [],
  "author": "Raul Belloso M",
  "license": "ISC"
}
